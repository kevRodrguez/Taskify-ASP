@model TaskFormViewModel
@{
    ViewData["Title"] = "Editar tarea";
}

<div class="auth-page">
    <div class="content-card" style="max-width: 36rem; width: 100%;">
        <p class="brand-eyebrow mb-2">@Model.ProjectName</p>
        <h1 class="content-card__title">Editar tarea</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-brand-danger" role="alert"></div>
            <input type="hidden" asp-for="TaskItemId"/>
            <input type="hidden" asp-for="ProjectId"/>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control"/>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="@((int)TaskItemStatus.Todo)">@TaskItemStatus.Todo.Display()</option>
                    <option value="@((int)TaskItemStatus.InProgress)">@TaskItemStatus.InProgress.Display()</option>
                    <option value="@((int)TaskItemStatus.Done)">@TaskItemStatus.Done.Display()</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control"/>
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AssignedToProfileId" class="form-label"></label>
                <select asp-for="AssignedToProfileId" asp-items="Model.Assignees" class="form-select"></select>
                <span asp-validation-for="AssignedToProfileId" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-brand-primary">Guardar</button>
                <a asp-action="Board" asp-route-projectId="@Model.ProjectId" class="btn-brand-secondary">Volver al tablero</a>
            </div>
        </form>

        <hr class="my-4"/>
        <form asp-action="Delete" asp-route-id="@Model.TaskItemId" method="post" onsubmit="return confirm('¿Eliminar esta tarea?');">
            <button type="submit" class="btn-brand-danger btn-sm">Eliminar tarea</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-page">
    <div class="auth-card">
        <p class="brand-eyebrow mb-2">Recuperación</p>
        <h1 class="auth-card__title">Recuperar contraseña</h1>
        <p class="auth-card__subtitle">
            Escribe tu correo y te enviaremos un enlace para elegir una contraseña nueva.
        </p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-brand-danger" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-brand-primary w-100">Enviar enlace</button>
        </form>

        <hr class="my-4"/>

        <p class="small mb-0 text-center">
            <a asp-action="Login" class="brand-link">Volver a iniciar sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

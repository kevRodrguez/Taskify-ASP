@using System.Security.Claims
@using Taskify.Auth
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="auth-page">
    <div class="content-card" style="max-width: var(--auth-card-max); width: 100%;">
        <p class="brand-eyebrow mb-2">Cuenta</p>
        <h1 class="content-card__title">Mi perfil</h1>

        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@(User.FindFirstValue(TaskifyClaimTypes.FullName) ?? "Sin definir")</dd>

            <dt class="col-sm-4">Correo</dt>
            <dd class="col-sm-8">@User.FindFirstValue(ClaimTypes.Email)</dd>

            <dt class="col-sm-4">ID de usuario</dt>
            <dd class="col-sm-8"><code>@User.FindFirstValue(ClaimTypes.NameIdentifier)</code></dd>
        </dl>

        <hr class="my-4"/>

        <a asp-action="ResetPassword" class="btn-brand-secondary btn-sm">Cambiar contraseña</a>
    </div>
</div>

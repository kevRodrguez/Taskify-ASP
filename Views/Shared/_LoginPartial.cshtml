@using System.Security.Claims
@using Taskify.Auth

@if (User.Identity?.IsAuthenticated ?? false)
{
    var displayName = User.FindFirstValue(TaskifyClaimTypes.FullName)
                      ?? User.FindFirstValue(ClaimTypes.Email)
                      ?? "Mi cuenta";

    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @displayName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Profile">Mi perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item">Cerrar sesión</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav align-items-sm-center gap-sm-2">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
        </li>
        <li class="nav-item">
            <a asp-controller="Auth" asp-action="Register" class="btn-brand-primary btn-sm">Registrarse</a>
        </li>
    </ul>
}

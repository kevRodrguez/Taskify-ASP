@using System.Security.Claims
@using Taskify.Auth

@* El partial no consulta a Supabase ni lee la cookie: UseAuthentication ya ejecuto
   SupabaseAuthenticationHandler al inicio de la peticion y dejo el ClaimsPrincipal
   resuelto en HttpContext.User, que es lo unico que se mira aqui. *@
@if (User.Identity?.IsAuthenticated ?? false)
{
    @* Cadena de respaldos: nombre completo, si no el correo, si no un texto generico. *@
    var displayName = User.FindFirstValue(TaskifyClaimTypes.FullName)
                      ?? User.FindFirstValue(ClaimTypes.Email)
                      ?? "Mi cuenta";

    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @displayName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                @* asp-controller/asp-action generan el href desde la tabla de rutas, asi
                   que el enlace sigue siendo valido si cambian las rutas. *@
                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Profile">Mi perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    @* Cerrar sesion va por POST porque modifica estado: un enlace GET podria
                       dispararse con cualquier precarga de URLs. El tag helper de form inyecta
                       ademas el token antiforgery que valida el AuthController. *@
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item">Cerrar sesión</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    @* Sin sesion, la navbar solo ofrece las dos entradas publicas. *@
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">Registrarse</a>
        </li>
    </ul>
}

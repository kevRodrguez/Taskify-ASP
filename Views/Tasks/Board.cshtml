@model KanbanBoardViewModel
@{
    ViewData["Title"] = $"Tablero · {Model.ProjectName}";
}

<div class="page-header">
    <div>
        <p class="brand-eyebrow mb-2">@Model.TeamName</p>
        <h1 class="page-title">@Model.ProjectName</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn-brand-secondary btn-sm">Detalle</a>
        <a asp-action="Create" asp-route-projectId="@Model.ProjectId" class="btn-brand-primary btn-sm">Nueva tarea</a>
    </div>
</div>

<form id="kanban-af" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="kanban" data-project-id="@Model.ProjectId" data-hub-url="@Url.Content("~/hubs/tasks")">
    <section class="kanban-column">
        <header class="kanban-column__header">Por hacer</header>
        <div class="kanban-column__list" data-status="@((int)TaskItemStatus.Todo)">
            @foreach (var task in Model.Todo)
            {
                <partial name="_TaskCard" model="task"/>
            }
        </div>
    </section>
    <section class="kanban-column">
        <header class="kanban-column__header">En curso</header>
        <div class="kanban-column__list" data-status="@((int)TaskItemStatus.InProgress)">
            @foreach (var task in Model.InProgress)
            {
                <partial name="_TaskCard" model="task"/>
            }
        </div>
    </section>
    <section class="kanban-column">
        <header class="kanban-column__header">Finalizado</header>
        <div class="kanban-column__list" data-status="@((int)TaskItemStatus.Done)">
            @foreach (var task in Model.Done)
            {
                <partial name="_TaskCard" model="task"/>
            }
        </div>
    </section>
</div>

<template id="task-card-template">
    <article class="kanban-card" data-task-id="" draggable="false">
        <h3 class="kanban-card__title"></h3>
        <p class="kanban-card__meta assigned"></p>
        <p class="kanban-card__meta due"></p>
        <a class="brand-link small edit-link" href="#">Editar</a>
    </article>
</template>

@section Scripts {
    <script src="~/lib/sortablejs/Sortable.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/kanban.js" asp-append-version="true"></script>
}

@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
}

<div class="auth-page">
    <div class="auth-card">
        <p class="brand-eyebrow mb-2">Seguridad</p>
        <h1 class="auth-card__title">Nueva contraseña</h1>
        <p class="auth-card__subtitle">Elige la contraseña con la que entrarás a partir de ahora.</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-brand-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-brand-primary w-100">Guardar contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

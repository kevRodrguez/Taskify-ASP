@model TeamFormViewModel
@{
    ViewData["Title"] = "Editar equipo";
}

<div class="auth-page">
    <div class="content-card" style="max-width: var(--auth-card-max); width: 100%;">
        <p class="brand-eyebrow mb-2">Equipos</p>
        <h1 class="content-card__title">Editar equipo</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-brand-danger" role="alert"></div>
            <input type="hidden" asp-for="TeamId"/>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus/>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-brand-primary">Guardar</button>
                <a asp-action="Details" asp-route-id="@Model.TeamId" class="btn-brand-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

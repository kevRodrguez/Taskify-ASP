@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <div class="auth-card">
        <p class="brand-eyebrow mb-2">Registro</p>
        <h1 class="auth-card__title">Crear cuenta</h1>
        <p class="auth-card__subtitle">Regístrate para empezar a usar Taskify.</p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-brand-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" autofocus/>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username"/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password"/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-brand-primary w-100">Crear cuenta</button>
        </form>

        <hr class="my-4"/>

        <p class="small mb-0 text-center">
            ¿Ya tienes cuenta? <a asp-action="Login" class="brand-link">Inicia sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
